{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true
  },
  "include": ["./**/*", "../src/.generated/config.d.ts"]
}
