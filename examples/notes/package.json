{
  "name": "notes",
  "displayName": "Notes (exemplo sigil)",
  "description": "Exemplo de Webview do sigil: assets externos reescritos via asWebviewUri, protocolo de mensagens tipado e estado que sobrevive ao painel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/sigilkit.git",
    "directory": "examples/notes"
  },
  "homepage": "https://github.com/JonathanSantos/sigilkit#readme",
  "bugs": {
    "url": "https://github.com/JonathanSantos/sigilkit/issues"
  },
  "version": "0.0.1",
  "publisher": "sigil-example",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "sigil build && npm run bundle",
    "bundle": "esbuild src/.generated/wire.ts --bundle --platform=node --format=cjs --target=es2022 --external:vscode --sourcemap --outfile=out/extension.js",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@sigilkit/core": "0.10.1"
  },
  "devDependencies": {
    "@sigilkit/cli": "0.10.1",
    "@sigilkit/test": "0.10.1",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.2",
    "@vscode/vsce": "^3.2.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "notes.open",
        "title": "Open Notes",
        "category": "Notes"
      }
    ],
    "configuration": {
      "title": "Notes",
      "properties": {
        "notes.maxNotes": {
          "type": "number",
          "default": 10,
          "description": "Máximo de notas guardadas",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "notes.panel",
          "name": "Notes",
          "type": "webview"
        }
      ]
    }
  }
}
