{
  "name": "todos",
  "displayName": "Todos (exemplo sigil)",
  "description": "Exemplo de TreeView interativa do sigil: estado mutável, showInputBox, menu de contexto por item e refresh dirigido por @Watch.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/sigilkit.git",
    "directory": "examples/todos"
  },
  "homepage": "https://github.com/JonathanSantos/sigilkit#readme",
  "bugs": {
    "url": "https://github.com/JonathanSantos/sigilkit/issues"
  },
  "version": "0.0.1",
  "publisher": "sigil-example",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "sigil build && npm run bundle",
    "bundle": "esbuild src/.generated/wire.ts --bundle --platform=node --format=cjs --target=es2022 --external:vscode --sourcemap --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@sigilkit/core": "0.4.0"
  },
  "devDependencies": {
    "@sigilkit/cli": "0.4.0",
    "@sigilkit/test": "0.4.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.2",
    "@vscode/vsce": "^3.2.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "todos.addTodo",
        "title": "Add Todo",
        "icon": "$(add)"
      },
      {
        "command": "todos.clearCompleted",
        "title": "Clear Completed",
        "category": "Todos"
      },
      {
        "command": "todos.toggleDone",
        "title": "Toggle Done",
        "icon": "$(check)"
      }
    ],
    "configuration": {
      "title": "Todos",
      "properties": {
        "todos.showCompleted": {
          "type": "boolean",
          "default": true,
          "description": "Exibir também os todos concluídos"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "todos.addTodo",
          "when": "view == todos.list"
        }
      ],
      "view/item/context": [
        {
          "command": "todos.toggleDone",
          "when": "view == todos.list",
          "group": "inline"
        }
      ]
    },
    "views": {
      "todos-suite": [
        {
          "id": "todos.list",
          "name": "Todos"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todos-suite",
          "title": "Todos",
          "icon": "media/icon.svg"
        }
      ]
    }
  }
}
