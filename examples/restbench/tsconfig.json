{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "outDir": "out",
    "skipLibCheck": true
  },
  "include": ["src", "src/.generated/**/*"]
}
