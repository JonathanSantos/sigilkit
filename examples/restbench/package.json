{
  "name": "restbench",
  "displayName": "REST Bench",
  "description": "A REST client inside VS Code — send requests, inspect responses in real editors, and let Copilot call your API. Built with the sigil framework.",
  "version": "0.1.0",
  "publisher": "sigilkit",
  "icon": "media/icon.png",
  "license": "MIT",
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "rest",
    "http",
    "api",
    "client",
    "copilot",
    "agent mode",
    "sigil"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanSantos/sigilkit"
  },
  "homepage": "https://github.com/JonathanSantos/sigilkit/tree/main/examples/restbench",
  "bugs": {
    "url": "https://github.com/JonathanSantos/sigilkit/issues"
  },
  "galleryBanner": {
    "color": "#1e1b2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "build": "npm run build:ui && sigil build && npm run bundle",
    "build:ui": "esbuild ui/src/main.tsx --bundle --format=iife --target=es2022 --jsx=automatic --outfile=ui/dist/main.js --minify",
    "bundle": "esbuild src/.generated/wire.ts --bundle --platform=node --format=cjs --target=es2022 --external:vscode --sourcemap --minify --outfile=out/extension.js",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "dev:ui": "esbuild ui/src/main.tsx --bundle --format=iife --target=es2022 --jsx=automatic --outfile=ui/dist/main.js --watch=forever",
    "sim": "sigil sim --ui .",
    "sandbox": "sigil sandbox ."
  },
  "dependencies": {
    "@sigilkit/core": "0.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@sigilkit/cli": "0.9.1",
    "@sigilkit/test": "0.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.2",
    "@vscode/vsce": "^3.2.1"
  },
  "sigil": {
    "uiDev": "npm run dev:ui"
  },
  "contributes": {
    "commands": [
      {
        "command": "restbench.clearHistory",
        "title": "Clear History",
        "category": "REST Bench",
        "enablement": "restbench.temHistorico"
      },
      {
        "command": "restbench.configure",
        "title": "Configure"
      },
      {
        "command": "restbench.open",
        "title": "Open",
        "category": "REST Bench"
      }
    ],
    "configuration": {
      "title": "Restbench",
      "properties": {
        "restbench.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Prefixo para URLs relativas (ex: https://api.exemplo.com)"
        },
        "restbench.historyLimit": {
          "type": "number",
          "default": 20,
          "description": "Máximo de entradas no histórico",
          "minimum": 1,
          "maximum": 100
        },
        "restbench.timeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "Timeout de cada requisição (ms)",
          "minimum": 100,
          "maximum": 120000
        }
      }
    },
    "languageModelTools": [
      {
        "name": "restbench_history",
        "displayName": "restbench_history",
        "modelDescription": "Retorna as requisições recentes do histórico do REST Bench, com método, URL, status e corpo das respostas — útil para inspecionar o que a API devolveu.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "description": "quantas entradas recentes retornar (default: 5)"
            }
          }
        }
      },
      {
        "name": "restbench_request",
        "displayName": "restbench_request",
        "modelDescription": "Executa uma requisição HTTP pelo REST Bench, usando a baseUrl, o token de autorização e o timeout configurados pelo usuário. Retorna status, tempo e corpo da resposta.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "request",
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "URL absoluta, ou caminho relativo à baseUrl configurada"
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
              ],
              "description": "método HTTP (default: GET)"
            },
            "body": {
              "type": "string",
              "description": "corpo JSON, como texto"
            }
          },
          "required": [
            "url"
          ]
        }
      }
    ]
  }
}
