exports[`coletor sobre examples/hello > snapshot do wire 1`] = `
"// GERADO POR sigil — NÃO EDITE
import * as vscode from "vscode";
import { registry, adoptRegistrations, bindConfigWatchers, bindLog, guard, bindTreeView, bindWebview, bindStatusBar, bindSettingsApp, bindLanguage, bindEvery } from "@sigilkit/core";
import { HelloExtension, MarkdownAssist } from "../extension";
import { TasksView } from "../views/tasks";
import { SettingsPanel } from "../panels/settings";

const COMMANDS = [
  {
    "key": "HelloExtension.openSettings",
    "id": "hello.openSettings"
  },
  {
    "key": "TasksView.refreshTasks",
    "id": "hello.refreshTasks"
  },
  {
    "key": "HelloExtension.reset",
    "id": "hello.reset"
  },
  {
    "key": "HelloExtension.sayHello",
    "id": "hello.sayHello"
  }
] as const;
const WATCHES = [
  {
    "key": "HelloExtension.onGreetingChanged",
    "targetConfigId": "hello.greeting"
  }
] as const;

let instance: HelloExtension | undefined;

/**
 * (Re)instancia as classes e adota as registrações no registry. O hot swap
 * (sigil sandbox) re-executa isto num bundle recém-carregado: os registros do
 * VSCode ficam intactos e o dispatch dinâmico passa a apontar para os
 * handlers novos.
 */
export function __sigilHydrate() {
  instance = new HelloExtension();
  adoptRegistrations("HelloExtension", HelloExtension);
  registry.instances.set(HelloExtension, instance);
  const i_TasksView = new TasksView();
  adoptRegistrations("TasksView", TasksView);
  registry.instances.set(TasksView, i_TasksView);
  const i_SettingsPanel = new SettingsPanel();
  adoptRegistrations("SettingsPanel", SettingsPanel);
  registry.instances.set(SettingsPanel, i_SettingsPanel);
  (i_SettingsPanel as { post?: (msg: unknown) => void }).post = (msg) => registry.webviewPosts.get("SettingsPanel")!(msg);
  registry.webviewKeys.set(SettingsPanel, "SettingsPanel");
  const i_MarkdownAssist = new MarkdownAssist();
  adoptRegistrations("MarkdownAssist", MarkdownAssist);
  registry.instances.set(MarkdownAssist, i_MarkdownAssist);
}

/** Hot reload de UI: re-preenche o HTML dos webviews ABERTOS. */
export function __sigilRefreshWebviews() {
  for (const h of registry.webviews.values()) void h.refresh?.();
}

/** Roda o @Activate — na ativação e depois de cada hot swap. */
export function __sigilActivateLifecycle() {
  registry.lifecycle.get("HelloExtension.onActivate")?.(registry.context);
}

export async function activate(ctx: vscode.ExtensionContext) {
  registry.context = ctx;
  registry.prefix = "hello";
  ctx.subscriptions.push(bindLog("hello"));
  __sigilHydrate();
  ctx.subscriptions.push(bindTreeView({"key":"TasksView","id":"hello.tasks","rootsKey":"TasksView.roots","childrenKey":"TasksView.children","itemKey":"TasksView.render"}));
  ctx.subscriptions.push(bindWebview({"key":"SettingsPanel","id":"hello.settings","title":"Hello Settings","uiEntry":"ui/settings.html","handlers":[{"type":"reset","key":"SettingsPanel.onReset"},{"type":"save","key":"SettingsPanel.onSave"}],"requests":[]}, ctx));
  ctx.subscriptions.push(bindLanguage({"key":"MarkdownAssist","selector":["markdown"],"hoverKey":"MarkdownAssist.hover","diagnosticsKey":"MarkdownAssist.pendencias","diagnosticsOn":"change"}, ctx));
  ctx.subscriptions.push(bindEvery("HelloExtension"));
  ctx.subscriptions.push(bindStatusBar({"key":"HelloExtension.status","alignment":"left","priority":100,"command":"hello.sayHello","tooltip":"Diga olá"}));
  const settingsApp = bindSettingsApp({"viewType":"hello.sigilSettings","title":"hello — Configurações","prefix":"hello","fields":[{"id":"hello.greeting","label":"greeting","type":"string","description":"Texto exibido na saudação","default":"Olá"},{"id":"hello.retries","label":"retries","type":"number","description":"Número de tentativas","minimum":1,"maximum":10,"default":3}]}, ctx);
  ctx.subscriptions.push(settingsApp);
  ctx.subscriptions.push(vscode.commands.registerCommand("hello.configure", guard("comando hello.configure", () => settingsApp.open(), { notify: true })));
  for (const c of COMMANDS) {
    if (!registry.commands.has(c.key)) throw new Error(\`sigil: handler ausente para \${c.key}. Rode 'sigil build'.\`);
    const invoke = (...args: unknown[]) => registry.commands.get(c.key)!(...args);
    const handler = invoke;
    ctx.subscriptions.push(vscode.commands.registerCommand(c.id, guard(\`comando \${c.id}\`, handler, { notify: true })));
  }
  ctx.subscriptions.push(bindConfigWatchers(WATCHES));
  __sigilActivateLifecycle();
}

export function deactivate() {
  instance = undefined;
}
"
`;

