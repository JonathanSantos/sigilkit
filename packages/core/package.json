{
  "name": "@sigilkit/core",
  "version": "0.9.0",
  "description": "Runtime do sigil — decorators e registry. Vai para o bundle da extensão; nunca importa typescript (R1).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/sigilkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/JonathanSantos/sigilkit#readme",
  "bugs": {
    "url": "https://github.com/JonathanSantos/sigilkit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b ."
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}
